# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/

# Environment files and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Runtime data, generated PDFs, and uploads
backend/storage/*
!backend/storage/.gitkeep
**/storage/*.pdf
**/uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Backups and temporary files
*.bak
*.backup
*.tmp
*.before-*
*.before_*

# Root src contains unrelated QMS files
/src/

# Backend backup and pre-change files
**/*.backup.*
**/*.before-*
**/*.before_*
# Accidental duplicate Dockerfile
/backend/Dockerfile.txt
